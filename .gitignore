# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native — generated by CNG, never commit by hand
/ios
/android
.kotlin/
*.orig.*

# Signing keys & credentials — NEVER commit
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
credentials.json

# Metro
.metro-health-check*
.metro-cache/

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# local env files (EAS secrets / eas.json env live in the cloud, not here)
.env
.env*.local

# typescript
*.tsbuildinfo

# macOS / Windows OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.lnk

# NOTE: .vscode/extensions.json is committed on purpose (shared editor setup).
